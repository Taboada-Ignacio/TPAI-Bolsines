# Credenciales de desarrollo para Docker Compose.
POSTGRES_USER=bolsines
POSTGRES_PASSWORD=bolsines_dev
POSTGRES_DB=bolsines
POSTGRES_PORT=5432

# Conexión para Prisma y Next.js ejecutados desde el equipo anfitrión.
DATABASE_URL=postgresql://bolsines:bolsines_dev@127.0.0.1:5432/bolsines

# Opcional. Compose arma la conexión interna con las variables POSTGRES_*.
# DOCKER_DATABASE_URL=postgresql://bolsines:bolsines_dev@postgres:5432/bolsines
