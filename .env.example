# Credenciales de desarrollo para Docker Compose.
POSTGRES_USER=bolsines
POSTGRES_PASSWORD=bolsines_dev
POSTGRES_DB=bolsines
POSTGRES_PORT=5432

# Conexión para Prisma y Next.js ejecutados desde el equipo anfitrión.
DATABASE_URL=postgresql://bolsines:bolsines_dev@127.0.0.1:5432/bolsines

# Opcional. Compose arma la conexión interna con las variables POSTGRES_*.
# DOCKER_DATABASE_URL=postgresql://bolsines:bolsines_dev@postgres:5432/bolsines

# Configurar una clave aleatoria de al menos 32 bytes para el inicio de sesión local.
SESSION_SIGNING_KEY=

# Claves públicas de demostración del GPS oficial. Compose las comparte entre el backend y Java.
GPS_TRACKER_XTR_API_KEY=sk_xtr_9F3a7C21bE6d4A10f2c8e5b7d913
GPS_TRACKER_NAVTRACK_API_KEY=sk_nav_7b61d9e4c3a2485fae10c77d5b2f
GPS_TRACKER_GEOPULSE_API_KEY=sk_geo_f2d84a1c9e7345b8a6d1c3f0972e
# Desde el anfitrión. Compose usa http://gps-tracker:8080 dentro de su red.
GPS_TRACKER_BASE_URL=http://127.0.0.1:8080
GPS_TRACKER_PORT=8080

# Opcional. Habilita el mapa interactivo de Google Maps en /seguimiento.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
